diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -169,7 +169,11 @@
         SOURCE_DIR ${LLGUIDANCE_SRC}
         BUILD_IN_SOURCE TRUE
         CONFIGURE_COMMAND ""
-        BUILD_COMMAND cargo build --release --package llguidance
+        BUILD_COMMAND cargo build --release --package llguidance --target-dir ${LLGUIDANCE_SRC}/target
+        # Stage the header independently of Cargo build.rs OUT_DIR changes.
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            ${LLGUIDANCE_SRC}/parser/llguidance.h
+            ${LLGUIDANCE_PATH}/llguidance.h
         INSTALL_COMMAND ""
         BUILD_BYPRODUCTS ${LLGUIDANCE_PATH}/${LLGUIDANCE_LIB_NAME} ${LLGUIDANCE_SRC}/parser/llguidance.h
         UPDATE_COMMAND ""
@@ -183,7 +187,11 @@
     target_include_directories(${TARGET} PRIVATE ${LLGUIDANCE_SRC}/parser)
     target_link_libraries(${TARGET} PRIVATE llguidance)
     if (WIN32)
-        target_link_libraries(${TARGET} PRIVATE ws2_32 userenv ntdll bcrypt)
+        # Rust's std implements Mutex/Condvar/RwLock on WaitOnAddress and
+        # WakeByAddress*, which are exported from Synchronization.lib. A Rust
+        # staticlib does not record that native dependency, so link it here
+        # instead of relying on the directives inside llguidance.lib.
+        target_link_libraries(${TARGET} PRIVATE ws2_32 userenv ntdll bcrypt synchronization)
     endif()
 endif()
 
