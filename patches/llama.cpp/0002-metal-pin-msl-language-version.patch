+// The enabled device features determine the minimum Metal language version.
+// Pinning this explicitly avoids inheriting an older default from the SDK used
+// to link the embedding host (for example, Python from conda or python.org).
+static void ggml_metal_compile_options_set_lang(MTLCompileOptions * options, bool has_tensor, bool has_bfloat) {
+    if (has_tensor) {
+        options.languageVersion = (MTLLanguageVersion) MTLLanguageVersion4_0_GGML;
+    } else if (has_bfloat) {
+        options.languageVersion = (MTLLanguageVersion) MTLLanguageVersion3_1_GGML;
+    }
+}
+
+// Metal can raise an NSException rather than populate NSError when the linked
+// framework does not recognize a requested language version. Convert that into
+// an ordinary compile failure so an embedded Python process is not aborted.
+static id<MTLLibrary> ggml_metal_compile_source(
+        id<MTLDevice> device, NSString * src, MTLCompileOptions * options, NSError ** error) {
+    @try {
+        return [device newLibraryWithSource:src options:options error:error];
+    } @catch (NSException * exception) {
+        GGML_LOG_ERROR("%s: exception while compiling metal source: %s\n", __func__, [[exception reason] UTF8String]);
+        return nil;
